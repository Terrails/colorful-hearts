{
	"schemaVersion": 1,
	"id": "colorfulhearts_extensions",
	"version": "${mod_version}",

	"name": "Colorful Hearts Extensions",
	"description": "A builtin module for Colorful Hearts adding compatibility with other mods.",
	"authors": [
		"Terrails"
	],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/Terrails/colorful-hearts",
		"issues": "https://github.com/Terrails/colorful-hearts/issues"
	},

	"icon": "icon.png",

	"environment": "client",
	"entrypoints": {
		"client": [
			"terrails.colorfulhearts.extensions.fabric.ColorfulHeartsExtensions"
		],
		"appleskin": [
			"terrails.colorfulhearts.extensions.fabric.compat.AppleSkinCompat"
		]
	},

	"mixins": [
		"colorfulhearts_extensions.mixins.json"
	],

	"accessWidener": "colorfulhearts_extensions.accesswidener",

	"depends": {
		"minecraft": ">=${min_minecraft_version}",
		"fabricloader": ">=${min_fabric_loader_version}",
		"fabric-api": ">=${min_fabric_api_version}",
		"colorfulhearts": ">=${min_colorfulhearts_version}"
	},

	"custom": {
		"modmenu": {
			"parent": "colorfulhearts"
		}
	}
}